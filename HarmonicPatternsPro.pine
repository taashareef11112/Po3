//@version=6
indicator("Harmonic Patterns Pro", shorttitle="Harmonic Patterns Pro", overlay = true, max_lines_count = 500, max_labels_count = 500, max_polylines_count = 100, max_boxes_count = 500, max_bars_back = 5000)

// ============================================================================
//  ثوابت أساسية
// ============================================================================
const int MAX_PIV       = 160
const int MAX_GPAT      = 50
const int MAX_CPAT      = 30
const int ST_PREDICTIVE = 1
const int ST_COMPLETED  = 3

const float MERGE_ATR    = 0.35

var int  _MSPB_INIT = 60000
// أساس ثابت لعرض البار الزمني (ملّي ثانية) من إطار الرسم البياني نفسه بدل الفرق
// اللحظي، لتجنّب الفجوات (عطلات/جلسات) التي تُفسد إسقاطات D الزمنية.
int _tfSec = timeframe.in_seconds()
int g_msPerBar = _tfSec > 0 ? _tfSec * 1000 : int(math.max(nz(time - time[1], _MSPB_INIT), 1))

// حدود هندسة XABCD (تُطبَّق على كل الأنماط)
const bool  XABCD_STRICT_OVERLAP = true
const int   XABCD_MIN_LEG_BARS   = 5
const float XABCD_MIN_LEG_FRAC   = 0.10
const float XABCD_MIN_RETR       = 0.236
const float XABCD_MAX_LEG_ASYM   = 8.0

// ============================================================================
//  المدخلات العامة
// ============================================================================
string G1 = "General Settings & Liquidity Filter"
float i_Tol        = input.float(3.0, "Tolerance (for completed) %", minval = 1.0, maxval = 10.0, step = 0.5, group = G1) / 100.0
const float i_GTolMul    = 1.5
const float i_MinSizeMul = 1.2
const float i_atrFilter  = 1.0
const float i_RevSens    = 0.236
const int   i_GhostRB    = 2
bool  i_ChartLog   = true

string G_CONF = "Additional Confirmation Conditions"
bool  i_GhostAfterB= input.bool(true, "Enable predictive only after B break", group = G_CONF)
bool  i_CBreakKill = input.bool(true, "Invalidate predictive on C-leg break", group = G_CONF)
bool  i_UseReliab  = true

const float CBREAK_ATR_MULT = 0.15
const float DPROJ_SYM_MULT   = 1.5
const int   MAX_DRAW_DIST    = 9000
const bool  BREAK_ON_CLOSE  = true
const bool  PRZ_ON_CLOSE    = true

string G2 = "Harmonic Patterns"
bool i_Gartley   = input.bool(true, "Gartley",   inline = "p1", group = G2)
bool i_Bat       = input.bool(true, "Bat",       inline = "p1", group = G2)
bool i_AltBat    = input.bool(true, "Alt Bat",   inline = "p1", group = G2)
bool i_Butterfly = input.bool(true, "Butterfly", inline = "p2", group = G2)
bool i_Crab      = input.bool(true, "Crab",      inline = "p2", group = G2)
bool i_DeepCrab  = input.bool(true, "Deep Crab", inline = "p2", group = G2)
bool i_Shark     = input.bool(true, "Shark",     inline = "p3", group = G2)
bool i_Cypher    = input.bool(true, "Cypher",    inline = "p3", group = G2)

string G3 = "Visual Identity"
color  i_BullCol   = input.color(#00E5A0, "Bullish",     inline = "c1", group = G3)
color  i_BearCol   = input.color(#FF3B5C, "Bearish",     inline = "c1", group = G3)
color  i_GhostCol  = input.color(#8E9AA8, "Predictive",  inline = "c1", group = G3)
string i_LineStyle = input.string("dotted", "Line Style", options = ["dotted", "dashed", "solid"], inline = "l1", group = G3)
int    i_LineWidth = input.int(1, "Line Width", minval = 1, maxval = 7, inline = "l1", group = G3)
int    i_MaxGhost  = input.int(10, "Max predictive shown", minval = 0, maxval = 50, inline = "mx", group = G3)
int    i_MaxComp   = input.int(10, "Max completed shown",   minval = 0, maxval = 50, inline = "mx", group = G3)
int    i_SizePref  = 65
string i_LblSize   = input.string("tiny", "Text Size", options = ["tiny", "small", "normal"], inline = "l2", group = G3)
int    i_PRZLen    = input.int(100, "PRZ line length", minval = 50, maxval = 200, step = 10, inline = "prz2", group = G3)
string i_PRZShow   = input.string("Ratios", "Line content", options = ["Price", "Ratios"], inline = "prz2", group = G3)

string GL = "Scan Layers & Hybrid ZigZag"
bool i_L1 = input.bool(true, "Scalp",    inline = "ly1", group = GL)
bool i_L2 = input.bool(true, "Daily",    inline = "ly2", group = GL)
bool i_L3 = input.bool(true, "Swing",    inline = "ly2", group = GL)
bool i_L4 = input.bool(true, "Position", inline = "ly3", group = GL)
bool i_L5 = input.bool(true, "Macro",    inline = "ly3", group = GL)

int i_D1 = 21
int i_D2 = 34
int i_D3 = 55
int i_D4 = 89
int i_D5 = 144

float currentATR = ta.atr(14)

// ============================================================================
//  محرك التكيّف التلقائي
// ============================================================================
string G_ADAPT = "Automatic Harmonic Adaptation Engine"
bool  i_AutoAdapt = input.bool(true, "Enable auto-adaptation", group = G_ADAPT)
float i_AdaptStrength = input.float(1.0, "Adaptation strength", minval = 0.0, maxval = 1.0, step = 0.1, group = G_ADAPT)

const float ANCHOR_ATRFILT = 3.0
const float ANCHOR_REVSENS = 0.236
const float ANCHOR_GTOLMUL = 1.5
const float ANCHOR_MINSIZE = 2.0

const float LIM_ATRFILT_LO = 0.5,  LIM_ATRFILT_HI = 5.0
const float LIM_REVSENS_LO = 0.10, LIM_REVSENS_HI = 0.60
const float LIM_GTOLMUL_LO = 1.0,  LIM_GTOLMUL_HI = 3.0
const float LIM_MINSIZE_LO = 0.3,  LIM_MINSIZE_HI = 2.0

float _atrAvg   = ta.sma(currentATR, 50)
float _volRatio = _atrAvg > 0.0 ? currentATR / _atrAvg : 1.0

[_diP, _diM, _adx] = ta.dmi(14, 14)
float _sd        = ta.stdev(close, 20)
float _noiseRaw  = currentATR > 0.0 ? _sd / currentATR : 1.0

clamp01(float v) => math.max(0.0, math.min(1.0, v))

float _volN   = clamp01((_volRatio - 0.7) / (1.6 - 0.7))
float _trendN = clamp01((nz(_adx, 20.0) - 15.0) / (45.0 - 15.0))
float _noiseN = clamp01((_noiseRaw - 1.0) / (2.2 - 1.0))

adaptBetween(float lo, float anchor, float hi, float t) =>
    float raw = t <= 0.5 ? lo + (anchor - lo) * (t / 0.5) : anchor + (hi - anchor) * ((t - 0.5) / 0.5)
    raw

blendToAnchor(float target, float anchor, float strength) =>
    anchor + (target - anchor) * strength

float _atrRaw = adaptBetween(LIM_ATRFILT_LO, ANCHOR_ATRFILT, LIM_ATRFILT_HI, _volN)
float _atrAdapt = math.max(LIM_ATRFILT_LO, math.min(LIM_ATRFILT_HI, blendToAnchor(_atrRaw, ANCHOR_ATRFILT, i_AdaptStrength)))

float _revT   = 1.0 - _trendN
float _revRaw = adaptBetween(LIM_REVSENS_LO, ANCHOR_REVSENS, LIM_REVSENS_HI, _revT)
float _revAdapt = math.max(LIM_REVSENS_LO, math.min(LIM_REVSENS_HI, blendToAnchor(_revRaw, ANCHOR_REVSENS, i_AdaptStrength)))

float _gtolRaw = adaptBetween(LIM_GTOLMUL_LO, ANCHOR_GTOLMUL, LIM_GTOLMUL_HI, _noiseN)
float _gtolAdapt = math.max(LIM_GTOLMUL_LO, math.min(LIM_GTOLMUL_HI, blendToAnchor(_gtolRaw, ANCHOR_GTOLMUL, i_AdaptStrength)))

float _sizeRaw = adaptBetween(LIM_MINSIZE_LO, ANCHOR_MINSIZE, LIM_MINSIZE_HI, _volN)
float _sizeAdapt = math.max(LIM_MINSIZE_LO, math.min(LIM_MINSIZE_HI, blendToAnchor(_sizeRaw, ANCHOR_MINSIZE, i_AdaptStrength)))

float eff_atrFilter  = i_AutoAdapt ? _atrAdapt  : i_atrFilter
float eff_RevSens    = i_AutoAdapt ? _revAdapt  : i_RevSens
float eff_GTolMul    = i_AutoAdapt ? _gtolAdapt : i_GTolMul
float eff_MinSizeMul = i_AutoAdapt ? _sizeAdapt : i_MinSizeMul

// ============================================================================
//  الأنواع
// ============================================================================
type Pivot
    float price
    int   bar
    int   dir
    int   t = 0

type Pattern
    string name
    int    state
    bool   isBull
    float  pX
    float  pA
    float  pB
    float  pC
    float  pD
    int    bX
    int    bC
    int    bD
    bool   isGhost
    float  rXAB
    float  rABC
    float  rXAD
    int    layer   = 1
    float  przHigh = na
    float  przLow  = na
    float  score   = 0.0
    float  confScore = 1.0
    bool   aNew    = false
    bool   aActB   = false
    bool   aPRZ    = false
    bool   aComp   = false
    bool   activated = false
    string key     = ""
    string bkey    = ""
    int    tX = 0
    int    tA = 0
    int    tB = 0
    int    tC = 0
    int    tD = 0
    float  extC    = na
    bool   extInit = false
    bool   dLocked = false

// كل الأنماط الآن ذات بنية XABCD موحّدة (خمس نقاط X-A-B-C-D)
var array<string> NAMES = array.from("Gartley", "Bat", "Alt Bat", "Butterfly", "Crab", "Deep Crab", "Shark", "Cypher")

var array<Pivot>   pv1      = array.new<Pivot>()
var array<Pivot>   pv2      = array.new<Pivot>()
var array<Pivot>   pv3      = array.new<Pivot>()
var array<Pivot>   pv4      = array.new<Pivot>()
var array<Pivot>   pv5      = array.new<Pivot>()
var array<Pattern> gPat     = array.new<Pattern>()
var array<Pattern> cPat     = array.new<Pattern>()
var array<line>    gLines   = array.new<line>()
var array<polyline> gPolys  = array.new<polyline>()
var array<label>   gLabels  = array.new<label>()
var array<box>     gBoxes   = array.new<box>()
var array<string>  g_lastDrawnKeys = array.new<string>()
var map<string, bool> g_tried = map.new<string, bool>()

// ============================================================================
//  دوال مساعدة عامة
// ============================================================================
shade(color base, int et) =>
    float ut = color.t(base)
    int ft = int(math.min(et + (100.0 - et) * ut / 100.0, 100.0))
    color.new(base, ft)

// كل الأسعار في التداول موجبة؛ الوضع اللوغاريتمي يُطبَّق فقط عند تحقق ذلك،
// وإلا نرجع للوضع الخطّي (حماية موحّدة من math.pow/math.log على قيم <= 0).
fibLevel(float pFrom, float pTo, float ratio, bool isBull) =>
    float r = 0.0
    if i_ChartLog and pFrom > 0.0 and pTo > 0.0
        r := pTo * math.pow(pFrom / pTo, ratio)
    else
        r := pTo + (pFrom - pTo) * ratio
    r

fibRatio(float a, float b, float ref1, float ref2) =>
    float r = 0.0
    if i_ChartLog and a > 0.0 and b > 0.0 and ref1 > 0.0 and ref2 > 0.0
        float refLog = math.abs(math.log(ref2) - math.log(ref1))
        r := refLog > 0.0 ? math.abs(math.log(b) - math.log(a)) / refLog : 0.0
    else
        float ref = math.abs(ref2 - ref1)
        r := ref > 0.0 ? math.abs(b - a) / ref : 0.0
    r

inRange(float v, float mn, float mx, float tol) =>
    v >= mn * (1.0 - tol) and v <= mx * (1.0 + tol)

patKey(string nm, bool isBull, int layer, int bX, int bA, int bB, int bC) =>
    nm + (isBull ? "B" : "S") + str.tostring(layer) + "_" + str.tostring(bX) + "_" + str.tostring(bA) + "_" + str.tostring(bB) + "_" + str.tostring(bC)

baseKey(bool isBull, int layer, int bX, int bA, int bB) =>
    (isBull ? "B" : "S") + str.tostring(layer) + "_" + str.tostring(bX) + "_" + str.tostring(bA) + "_" + str.tostring(bB)

scoreFromDev(float dev, float tol) =>
    float n = tol > 0.0 ? dev / (tol * 1.5) : dev
    math.max(0.0, 1.0 - math.min(n, 1.0))

timeSymScore(int span1, int span2) =>
    float a = math.max(float(span1), 1.0)
    float b = math.max(float(span2), 1.0)
    float rr = math.abs(math.log(a / b))
    math.max(0.0, 1.0 - math.min(rr, 1.0))

priceSymScore(float len1, float len2) =>
    float mx = math.max(len1, len2)
    mx > 0.0 ? 1.0 - math.min(math.abs(len1 - len2) / mx, 1.0) : 0.0

legBalance(int s1, int s2, int s3, int s4) =>
    float mx = math.max(math.max(s1, s2), math.max(s3, s4))
    float mn = math.max(math.min(math.min(s1, s2), math.min(s3, s4)), 1)
    float asym = float(mx) / float(mn)
    math.min(1.0, 3.0 / math.max(asym, 1.0))

reliability(string n) =>
    not i_UseReliab ? 1.0 : n == "Gartley" ? 1.00 : n == "Bat" ? 1.00 : n == "Alt Bat" ? 0.95 : n == "Butterfly" ? 0.92 : n == "Shark" ? 0.90 : n == "Cypher" ? 0.90 : n == "Crab" ? 0.90 : 0.88

abcdScore(float lenAB, float lenCD, int timeAB, int timeCD) =>
    float ap = priceSymScore(lenAB, lenCD)
    float at = timeSymScore(timeAB, timeCD)
    0.6 * ap + 0.4 * at

// ============================================================================
//  جداول نِسَب الأنماط (كلها XABCD موحّدة)
//  B  = تصحيح XA عند B (rXAB)
//  BC = امتداد BC عند D (rBCD)
//  D  = امتداد/تصحيح XA عند D (rXAD)  <-- يحدّد منطقة PRZ
// ============================================================================
mwTol(string n, float baseTol) =>
    float mult = (n == "Deep Crab" or n == "Bat") ? (0.05 / 0.03) : 1.0
    baseTol * mult

mwB(string n) =>
    [lo, hi] = switch n
        "Gartley"   => [0.618, 0.618]
        "Bat"       => [0.382, 0.500]
        "Alt Bat"   => [0.382, 0.382]
        "Butterfly" => [0.786, 0.786]
        "Crab"      => [0.382, 0.618]
        "Deep Crab" => [0.886, 0.886]
        "Shark"     => [1.130, 1.618]
        "Cypher"    => [0.382, 0.618]
        => [0.0, 0.0]
    [lo, hi]

mwBC(string n) =>
    [lo, hi] = switch n
        "Gartley"   => [1.130, 1.618]
        "Bat"       => [1.618, 2.618]
        "Alt Bat"   => [2.000, 3.618]
        "Butterfly" => [1.618, 2.240]
        "Crab"      => [2.618, 3.618]
        "Deep Crab" => [2.000, 3.618]
        "Shark"     => [1.618, 2.240]
        "Cypher"    => [1.272, 1.414]
        => [0.0, 0.0]
    [lo, hi]

mwD(string n) =>
    [lo, hi] = switch n
        "Gartley"   => [0.786, 0.786]
        "Bat"       => [0.886, 0.886]
        "Alt Bat"   => [1.130, 1.130]
        "Butterfly" => [1.270, 1.270]
        "Crab"      => [1.618, 1.618]
        "Deep Crab" => [1.618, 1.618]
        "Shark"     => [0.886, 1.130]
        "Cypher"    => [0.786, 0.786]
        => [0.0, 0.0]
    [lo, hi]

// حدود تصحيح C (نسبة BC/AB) لكل نمط: [lo, hi]
mwC(string n) =>
    [lo, hi] = switch n
        "Cypher"    => [0.382, 0.618]
        "Shark"     => [1.130, 1.618]
        => [0.382, 0.886]
    [lo, hi]

ratioFit(float v, float lo, float hi) =>
    float ideal = (lo + hi) / 2.0
    ideal > 0 ? math.abs(v - ideal) / ideal : math.abs(v - ideal)

mwEnabled(string n) =>
    switch n
        "Gartley"   => i_Gartley
        "Bat"       => i_Bat
        "Alt Bat"   => i_AltBat
        "Butterfly" => i_Butterfly
        "Crab"      => i_Crab
        "Deep Crab" => i_DeepCrab
        "Shark"     => i_Shark
        "Cypher"    => i_Cypher
        => false

// هل النمط ممتد (D يتجاوز X)؟ يُحدَّد من نسبة D لا من اسم مُبرمَج يدويًا،
// حتى لا ينكسر إذا عُدِّلت النِسَب لاحقًا.
mwIsExt(string n) =>
    [dLo, dHi] = mwD(n)
    (dLo + dHi) / 2.0 > 1.0

mwFindBest(float rXAB, float rBCD, float rXAD, float rCAB, float baseTol) =>
    string best = ""
    float bestFit = 1e30
    for ni = 0 to array.size(NAMES) - 1
        string nm = array.get(NAMES, ni)
        if mwEnabled(nm)
            float tol = mwTol(nm, baseTol)
            [b1, b2] = mwB(nm)
            [c1, c2] = mwBC(nm)
            [d1, d2] = mwD(nm)
            [cc1, cc2] = mwC(nm)
            bool cOk = rCAB >= cc1 * (1.0 - tol) and rCAB <= cc2 * (1.0 + tol)
            if cOk and inRange(rXAB, b1, b2, tol) and inRange(rBCD, c1, c2, tol) and inRange(rXAD, d1, d2, tol)
                float fit = ratioFit(rXAD, d1, d2)
                if fit < bestFit
                    bestFit := fit
                    best := nm
    best

// منطقة PRZ = نطاق نسب D مُسقَطة على ضلع XA فقط (مستوى D لكارني)
mwPRZ(string name, float pX, float pA, bool isBull) =>
    [dLo, dHi] = mwD(name)
    float xaLo = fibLevel(pX, pA, dLo, isBull)
    float xaHi = fibLevel(pX, pA, dHi, isBull)
    float lo = math.min(xaLo, xaHi)
    float hi = math.max(xaLo, xaHi)
    // للأنماط ذات نقطة D واحدة (lo==hi) نمنح نطاقًا رفيعًا حول النقطة حتى
    // يُرسم صندوق PRZ ويُكتشف الدخول، بدل خطٍّ بلا سماكة.
    if math.abs(hi - lo) < math.abs(pA - pX) * 0.001
        float band = math.abs(pA - pX) * 0.015
        lo := lo - band
        hi := hi + band
    [lo, hi]

przTightness(float przLo, float przHi, float pX, float pA) =>
    float lenXA = math.abs(pA - pX)
    float band  = math.abs(przHi - przLo)
    float ratio = lenXA > 0.0 ? band / lenXA : 1.0
    float t = 1.0 - math.min(math.max((ratio - 0.10) / 0.30, 0.0), 1.0)
    0.85 + 0.15 * t

layerSpec(int n, float sizeMul) =>
    int depth = n == 1 ? i_D1 : n == 2 ? i_D2 : n == 3 ? i_D3 : n == 4 ? i_D4 : i_D5
    int minSp = int(math.max(math.round(float(depth) * sizeMul), 5))
    bool on   = n == 1 ? i_L1 : n == 2 ? i_L2 : n == 3 ? i_L3 : n == 4 ? i_L4 : i_L5
    [depth, minSp, on]

// ============================================================================
//  التحقق الهندسي لبنية XABCD
// ============================================================================
xabcdBarsOk(int bX, int bA, int bB, int bC, int bD, bool hasD) =>
    bool ok = bX < bA and bA < bB and bB < bC
    ok := ok and (bA - bX) >= XABCD_MIN_LEG_BARS
    ok := ok and (bB - bA) >= XABCD_MIN_LEG_BARS
    ok := ok and (bC - bB) >= XABCD_MIN_LEG_BARS
    if hasD
        ok := ok and bC < bD
        ok := ok and (bD - bC) >= XABCD_MIN_LEG_BARS
    ok

xabcdDirsOk(int dX, int dA, int dB, int dC, int dD, bool hasD) =>
    bool ok = dX != dA and dA != dB and dB != dC
    if hasD
        ok := ok and dC != dD
    ok

xabcdLegsOk(float pX, float pA, float pB, float pC, float pD, bool hasD) =>
    bool ok = true
    float legXA = math.abs(pA - pX)
    float legAB = math.abs(pB - pA)
    float legBC = math.abs(pC - pB)
    float legCD = hasD ? math.abs(pD - pC) : na

    if legXA > 0.0
        float minLeg = legXA * XABCD_MIN_LEG_FRAC
        ok := ok and legAB >= minLeg
        ok := ok and legBC >= minLeg
        if hasD and not na(legCD)
            ok := ok and legCD >= minLeg

        ok := ok and (legAB / legXA) >= XABCD_MIN_RETR
        ok := ok and (legAB > 0.0 ? (legBC / legAB) >= XABCD_MIN_RETR : false)
        if hasD and not na(legCD) and legBC > 0.0
            ok := ok and (legCD / legBC) >= XABCD_MIN_RETR

        if legXA > 0.0 and legAB > 0.0
            ok := ok and (fibRatio(pA, pB, pX, pA) <= 1.02)
        if legAB > 0.0 and legBC > 0.0
            ok := ok and (fibRatio(pB, pC, pA, pB) <= 1.02)

        float mxLeg = math.max(math.max(legXA, legAB), legBC)
        float mnLeg = math.min(math.min(legXA, legAB), legBC)
        if hasD and not na(legCD)
            mxLeg := math.max(mxLeg, legCD)
            mnLeg := math.min(mnLeg, legCD)
        if mnLeg > 0.0
            ok := ok and (mxLeg / mnLeg <= XABCD_MAX_LEG_ASYM)
        else
            ok := false
    else
        ok := false
    ok

// الهندسة تقبل الأنماط الممتدة (D خلف X) والعادية (D بين B وX) على السواء.
xabcdGeoOk(float pX, float pA, float pB, float pC, float pD, bool isBull, bool hasD, bool isExt) =>
    float buf = math.abs(pA - pX) * 0.02
    bool ok = true
    if isBull
        ok := ok and pA > pX + buf
        ok := ok and pB < pA - buf
        ok := ok and pC > pB + buf
        ok := ok and pC < pA + buf
        if hasD
            if isExt
                ok := ok and pD < pX - buf
            else
                ok := ok and pD < pB - buf
    else
        ok := ok and pA < pX - buf
        ok := ok and pB > pA + buf
        ok := ok and pC < pB - buf
        ok := ok and pC > pA - buf
        if hasD
            if isExt
                ok := ok and pD > pX + buf
            else
                ok := ok and pD > pB + buf
    ok

xabcdValid(float pX, float pA, float pB, float pC, float pD, int bX, int bA, int bB, int bC, int bD, int dX, int dA, int dB, int dC, int dD, bool isBull, bool hasD, bool isExt) =>
    xabcdBarsOk(bX, bA, bB, bC, bD, hasD) and xabcdDirsOk(dX, dA, dB, dC, dD, hasD) and xabcdGeoOk(pX, pA, pB, pC, pD, isBull, hasD, isExt) and xabcdLegsOk(pX, pA, pB, pC, pD, hasD)

// ============================================================================
//  نقاط الارتكاز الحقيقية (القمم/القيعان الفعلية)
// ============================================================================
rightBarsFor(int depth) =>
    int rb = int(math.round(float(depth) / 18.0))
    math.max(2, math.min(rb, 8))

// يبحث بين barين عن أدنى قاع/أعلى قمة فعلية، ضمن نطاق محدود بـ max_bars_back.
trueSwingExtreme(int fromBar, int toBar, int dir, float seedPrice, int seedBar, int seedT) =>
    float bestP = seedPrice
    int   bestB = seedBar
    int   bestT = seedT
    int lo = math.max(fromBar + 1, 0)
    int hi = toBar
    // نحصر البحث ضمن 4900 بار (< max_bars_back=5000) لتجنّب runtime error.
    if hi >= lo and (bar_index - lo) < 4900
        for b = lo to hi
            int off = bar_index - b
            if off >= 0 and off < 4900
                float v = dir == -1 ? low[off] : high[off]
                if not na(v)
                    bool more = dir == -1 ? (v < bestP) : (v > bestP)
                    if more
                        bestP := v
                        bestB := b
                        bestT := time[off]
    [bestP, bestB, bestT]

// يصحّح آخر بايفوت إلى القمة/القاع الحقيقي بين البايفوت السابق والبار المقابل.
validateLastPivot(array<Pivot> arr, int oppBar) =>
    bool changed = false
    int sz = array.size(arr)
    if sz >= 2
        Pivot lastP = array.get(arr, 0)
        Pivot prevP = array.get(arr, 1)
        if oppBar > lastP.bar and prevP.bar < oppBar
            [tp, tb, tt] = trueSwingExtreme(prevP.bar, oppBar, lastP.dir, lastP.price, lastP.bar, lastP.t)
            bool improved = lastP.dir == -1 ? (tp < lastP.price) : (tp > lastP.price)
            if improved and tb > prevP.bar and tb < oppBar
                lastP.price := tp
                lastP.bar   := tb
                lastP.t     := tt
                changed := true
    changed

// ============================================================================
//  مسح البايفوت الموحّد (مسار واحد دقيق: كل البايفوتات قمم/قيعان حقيقية مؤكّدة)
// ============================================================================
pivotScan(array<Pivot> arr, int depth, float atrVal, float atrMult, float revSens) =>
    bool changed = false
    int rightBars = rightBarsFor(depth)
    float ph = ta.pivothigh(high, depth, rightBars)
    float pl = ta.pivotlow(low, depth, rightBars)

    if barstate.isconfirmed
        int pBar = bar_index - rightBars
        int pT   = time[rightBars]

        for pass = 0 to 1
            float price = pass == 0 ? ph : pl
            int   dir   = pass == 0 ? 1 : -1

            if not na(price)
                int sz = array.size(arr)
                if sz == 0
                    array.unshift(arr, Pivot.new(price, pBar, dir, pT))
                    changed := true
                else
                    Pivot last = array.get(arr, 0)

                    if last.dir == dir
                        // نفس الاتجاه: نحتفظ بالأكثر تطرفًا (القمة/القاع الحقيقي)
                        bool more = dir == 1 ? (price > last.price) : (price < last.price)
                        if more and pBar > last.bar
                            last.price := price
                            last.bar   := pBar
                            last.t     := pT
                            changed := true

                    else if pBar > last.bar
                        float moveSize = math.abs(price - last.price)
                        float reqSize = atrVal * atrMult * math.sqrt(depth / 21.0)
                        float retrRef = na
                        if sz >= 2
                            Pivot prev2 = array.get(arr, 1)
                            retrRef := math.abs(last.price - prev2.price)
                        float retrOk = na(retrRef) or retrRef <= 0.0 ? 1.0 : (moveSize / retrRef)
                        bool  revOk  = na(retrRef) or retrRef <= 0.0 ? true : retrOk >= revSens

                        if moveSize >= reqSize and revOk
                            if validateLastPivot(arr, pBar)
                                changed := true
                            bool merged = false
                            if sz >= 2
                                Pivot cand = array.get(arr, 1)
                                if cand.dir == dir
                                    float gap  = math.abs(price - cand.price)
                                    int   tgap = pBar - cand.bar
                                    if gap < atrVal * MERGE_ATR and tgap < depth
                                        bool takeNew = dir == 1 ? (price > cand.price) : (price < cand.price)
                                        if takeNew
                                            cand.price := price
                                            cand.bar   := pBar
                                            cand.t     := pT
                                        merged := true
                                        changed := true
                            if not merged
                                array.unshift(arr, Pivot.new(price, pBar, dir, pT))
                                changed := true

        while array.size(arr) > MAX_PIV
            array.pop(arr)
    changed

// ============================================================================
//  تسجيل الأنماط + الترقية من استباقي إلى مكتمل
// ============================================================================
registerPattern(Pattern np) =>
    if np.isGhost
        bool handled = false
        int gsz = array.size(gPat)
        if gsz > 0
            for i = 0 to gsz - 1
                if i < array.size(gPat)
                    Pattern g = array.get(gPat, i)
                    // القفل عند الظهور: الهوية = الهيكل (bkey). أول استباقي لهيكل
                    // معيّن يُجمَّد؛ لا يُعاد رسمه أو تصنيفه. يُحدَّث فقط علم كسر B.
                    if g.bkey == np.bkey
                        bool crossed = BREAK_ON_CLOSE ? (np.isBull ? (close <= g.pB) : (close >= g.pB)) : (np.isBull ? (low <= g.pB) : (high >= g.pB))
                        if crossed
                            g.activated := true
                        handled := true
                        break
                    if g.key == np.key
                        handled := true
                        break
        if not handled
            array.unshift(gPat, np)
        while array.size(gPat) > MAX_GPAT
            array.pop(gPat)
    else
        // نمط مكتمل: نحذف أي استباقي لنفس الهيكل (تمّت ترقيته)
        int gi = 0
        while gi < array.size(gPat)
            Pattern g = array.get(gPat, gi)
            if g.bkey == np.bkey
                array.remove(gPat, gi)
                break
            gi += 1
        bool dup = false
        int csz = array.size(cPat)
        if csz > 0
            for i = 0 to csz - 1
                if i < array.size(cPat)
                    Pattern c = array.get(cPat, i)
                    if c.key == np.key
                        dup := true
                        break
        if not dup
            array.unshift(cPat, np)
        while array.size(cPat) > MAX_CPAT
            array.pop(cPat)

// بوابة الاكتمال: D يجب أن يقع داخل [przLow, przHigh] حصراً، بلا حشو.
completionGate(Pivot D, float przLow, float przHigh) =>
    bool ok = na(przLow) or na(przHigh)
    if not ok
        float pLo = math.min(przLow, przHigh)
        float pHi = math.max(przLow, przHigh)
        ok := D.price >= pLo and D.price <= pHi
    ok

// يجد التطرف الحقيقي لنقطة D داخل نطاق PRZ (بحث محدود بـ 60 بار لكفاءة الأداء).
dExtreme(int bC, int bD, float dP0, bool isBull, float bandLo, float bandHi) =>
    float zLo = math.min(bandLo, bandHi)
    float zHi = math.max(bandLo, bandHi)
    float bestP = dP0
    int   bestB = bD
    int startB = int(math.max(bC + 1, bD - 60))
    int fwd    = bD

    if startB <= fwd and (bar_index - startB) < 4900
        for b = startB to fwd
            int off = bar_index - b
            if off >= 0 and off < 4900
                float v = isBull ? low[off] : high[off]
                if not na(v) and v >= zLo and v <= zHi
                    bool more = isBull ? (v < bestP) : (v > bestP)
                    if more
                        bestP := v
                        bestB := b
    [bestP, bestB]

// ============================================================================
//  اكتشاف الأنماط المكتملة (كل الأنماط عبر مسار XABCD واحد)
// ============================================================================
tryCompleteMW(array<Pivot> arr, int iX, int iA, int iB, int iC, int iD, int layerNum, float tol) =>
    if iD < array.size(arr) and iC < array.size(arr) and iB < array.size(arr) and iA < array.size(arr) and iX < array.size(arr)
        Pivot D = array.get(arr, iD)
        Pivot C = array.get(arr, iC)
        Pivot B = array.get(arr, iB)
        Pivot A = array.get(arr, iA)
        Pivot X = array.get(arr, iX)
        string sig = "C" + str.tostring(layerNum) + "_" + str.tostring(X.bar) + "_" + str.tostring(A.bar) + "_" + str.tostring(B.bar) + "_" + str.tostring(C.bar) + "_" + str.tostring(D.bar)
        bool already = map.contains(g_tried, sig)
        if not already
            int span = D.bar - X.bar
            [_ls0, minSp, _ls1] = layerSpec(layerNum, eff_MinSizeMul)
            if span >= minSp and span <= 1000
                bool isBull = D.dir == -1
                float XA = math.abs(A.price - X.price)
                float AB = math.abs(B.price - A.price)
                float BC = math.abs(C.price - B.price)
                float CD = math.abs(D.price - C.price)
                if XA > 0 and AB > 0 and BC > 0 and CD > 0
                    float rXAB = fibRatio(A.price, B.price, X.price, A.price)
                    float rBCD = fibRatio(C.price, D.price, B.price, C.price)
                    float rXAD = fibRatio(A.price, D.price, X.price, A.price)
                    float rCAB = fibRatio(B.price, C.price, A.price, B.price)
                    string best = mwFindBest(rXAB, rBCD, rXAD, rCAB, tol)
                    if best != ""
                        bool isExt = mwIsExt(best)
                        bool skeletonOk = xabcdValid(X.price, A.price, B.price, C.price, D.price, X.bar, A.bar, B.bar, C.bar, D.bar, X.dir, A.dir, B.dir, C.dir, D.dir, isBull, true, isExt)
                        if skeletonOk
                            [przL, przH] = mwPRZ(best, X.price, A.price, isBull)
                            bool _gateOK = completionGate(D, przL, przH)
                            if _gateOK
                                [ddLo, ddHi] = mwD(best)
                                float _bLo = fibLevel(X.price, A.price, ddLo, isBull)
                                float _bHi = fibLevel(X.price, A.price, ddHi, isBull)
                                [dP, dB] = dExtreme(C.bar, D.bar, D.price, isBull, _bLo, _bHi)
                                int dTm = D.t + (dB - D.bar) * g_msPerBar
                                float rXADr = fibRatio(A.price, dP, X.price, A.price)
                                Pattern cp = Pattern.new(best, ST_COMPLETED, isBull, X.price, A.price, B.price, C.price, dP, X.bar, C.bar, dB, false, rXAB, rCAB, rXADr, layerNum, przH, przL)
                                cp.key := patKey(best, isBull, layerNum, X.bar, A.bar, B.bar, C.bar)
                                cp.bkey := baseKey(isBull, layerNum, X.bar, A.bar, B.bar)
                                cp.dLocked := true
                                [sb1, sb2] = mwB(best)
                                [sd1, sd2] = mwD(best)
                                [sc1, sc2] = mwBC(best)
                                [scc1, scc2] = mwC(best)
                                float idealB  = (sb1 + sb2) / 2.0
                                float idealD  = (sd1 + sd2) / 2.0
                                float idealBC = (sc1 + sc2) / 2.0
                                float idealC  = (scc1 + scc2) / 2.0
                                float stol = mwTol(best, tol)
                                float cB  = scoreFromDev(idealB  > 0 ? math.abs(rXAB - idealB)  / idealB  : 1.0, stol)
                                float cD  = scoreFromDev(idealD  > 0 ? math.abs(rXAD - idealD)  / idealD  : 1.0, stol)
                                float cBC = scoreFromDev(idealBC > 0 ? math.abs(rBCD - idealBC) / idealBC : 1.0, stol)
                                float cC  = scoreFromDev(idealC  > 0 ? math.abs(rCAB - idealC)  / idealC  : 1.0, stol)
                                float cT = timeSymScore(B.bar - A.bar, C.bar - B.bar)
                                float cP = priceSymScore(AB, BC)
                                float cABCD = abcdScore(AB, CD, B.bar - A.bar, D.bar - C.bar)
                                float accuracy = 0.40 * cD + 0.25 * cB + 0.20 * cBC + 0.15 * cC
                                cp.score := (0.70 * accuracy + 0.12 * cABCD + 0.10 * cT + 0.08 * cP) * (0.7 + 0.3 * legBalance(A.bar - X.bar, B.bar - A.bar, C.bar - B.bar, D.bar - C.bar)) * reliability(best) * przTightness(przL, przH, X.price, A.price)
                                cp.tX := X.t
                                cp.tA := A.t
                                cp.tB := B.t
                                cp.tC := C.t
                                cp.tD := dTm
                                registerPattern(cp)
                                map.put(g_tried, sig, true)

// ============================================================================
//  اكتشاف الأنماط الاستباقية (X-A-B-C مكتمل، D مُسقَط)
// ============================================================================
projectMW(array<Pivot> arr, int iX, int iA, int iB, int iC, int layerNum, int minSp, float gtol) =>
    if iC < array.size(arr) and iB < array.size(arr) and iA < array.size(arr) and iX < array.size(arr)
        Pivot C = array.get(arr, iC)
        Pivot B = array.get(arr, iB)
        Pivot A = array.get(arr, iA)
        Pivot X = array.get(arr, iX)
        int curSpan = bar_index - X.bar
        if curSpan >= minSp and curSpan <= 1000
            bool isBull = X.dir == -1
            bool bV = isBull ? (B.price < A.price and B.price > X.price) : (B.price > A.price and B.price < X.price)
            bool cS = isBull ? (C.price < A.price and C.price > B.price) : (C.price > A.price and C.price < B.price)
            float XA = math.abs(A.price - X.price)
            float AB = math.abs(B.price - A.price)
            float BC = math.abs(C.price - B.price)
            if XA > 0 and AB > 0 and BC > 0 and bV and cS
                float rXAB = fibRatio(A.price, B.price, X.price, A.price)
                float cRetr = fibRatio(B.price, C.price, A.price, B.price)
                int abBars = math.max(B.bar - A.bar, 1)
                int bcBars = math.max(C.bar - B.bar, 1)
                float tRatio = float(abBars) / float(bcBars)
                int estCD = int(math.round(float(bcBars) * math.max(math.min(tRatio, 2.5), 0.5)))
                int projBar = C.bar + int(math.max(estCD, 8))
                string bestNm = ""
                float bestScore = -1.0

                for ni = 0 to array.size(NAMES) - 1
                    string nm = array.get(NAMES, ni)
                    if mwEnabled(nm)
                        float ptol = mwTol(nm, gtol)
                        [b1, b2] = mwB(nm)
                        [cc1, cc2] = mwC(nm)
                        bool cOk = cRetr >= cc1 * (1.0 - gtol) and cRetr <= cc2 * (1.0 + gtol)
                        if cOk and inRange(rXAB, b1, b2, ptol)
                            bool isExt = mwIsExt(nm)
                            bool priceCrossedX = isBull ? low < X.price : high > X.price
                            bool validForPrice = isExt ? priceCrossedX : (not priceCrossedX)
                            if validForPrice
                                float nIdealB = (b1 + b2) / 2.0
                                float ncB = scoreFromDev(nIdealB > 0 ? math.abs(rXAB - nIdealB) / nIdealB : 1.0, ptol)
                                float ncT = timeSymScore(B.bar - A.bar, C.bar - B.bar)
                                float ncP = priceSymScore(AB, BC)
                                float nScore = (0.60 * ncB + 0.20 * ncT + 0.20 * ncP) * reliability(nm)
                                if nScore > bestScore
                                    bestScore := nScore
                                    bestNm := nm

                bool cAlive = true
                if i_CBreakKill
                    float cPadg = currentATR * CBREAK_ATR_MULT
                    cAlive := isBull ? (high <= C.price + cPadg) : (low >= C.price - cPadg)

                if bestNm != "" and cAlive
                    [przL, przH] = mwPRZ(bestNm, X.price, A.price, isBull)
                    [dLo, dHi] = mwD(bestNm)
                    float dMid = (dLo + dHi) / 2.0
                    float projD = fibLevel(X.price, A.price, dMid, isBull)
                    // درجة ثقة إسقاط D: تماثل XAB=BCD السعري كمرجع.
                    float confScore = priceSymScore(AB, BC)

                    bool isAct = BREAK_ON_CLOSE ? (isBull ? close <= B.price : close >= B.price) : (isBull ? low <= B.price : high >= B.price)

                    Pattern gp = Pattern.new(bestNm, ST_PREDICTIVE, isBull, X.price, A.price, B.price, C.price, projD, X.bar, C.bar, projBar, true, rXAB, cRetr, dMid, layerNum, przH, przL)
                    gp.activated := isAct
                    gp.key := patKey(bestNm, isBull, layerNum, X.bar, A.bar, B.bar, C.bar)
                    gp.bkey := baseKey(isBull, layerNum, X.bar, A.bar, B.bar)
                    [gb1, gb2] = mwB(bestNm)
                    float gIdealB = (gb1 + gb2) / 2.0
                    float gcB = scoreFromDev(gIdealB > 0 ? math.abs(rXAB - gIdealB) / gIdealB : 1.0, mwTol(bestNm, gtol))
                    float gcT = timeSymScore(B.bar - A.bar, C.bar - B.bar)
                    float gcP = priceSymScore(AB, BC)
                    gp.score := (0.45 * gcB + 0.30 * confScore + 0.125 * gcT + 0.125 * gcP) * reliability(bestNm)
                    gp.confScore := confScore
                    gp.tX := X.t
                    gp.tA := A.t
                    gp.tB := B.t
                    gp.tC := C.t
                    gp.tD := C.t + (projBar - C.bar) * g_msPerBar
                    registerPattern(gp)

// ============================================================================
//  ماسحات الطبقات
// ============================================================================
scanComplete(array<Pivot> arr, int layerNum) =>
    float tol = i_Tol
    int sz = array.size(arr)
    if sz >= 5
        int upper = math.min(sz - 5, 30)
        for idx = 0 to upper
            Pivot pOut = array.get(arr, idx + 4)
            if (bar_index - pOut.bar > 1000)
                break
            tryCompleteMW(arr, idx + 4, idx + 3, idx + 2, idx + 1, idx, layerNum, tol)

scanPredictive(array<Pivot> arr, int layerNum) =>
    [depth, _sp0, _sp1] = layerSpec(layerNum, eff_MinSizeMul)
    float tol = i_Tol
    float gtol = tol * eff_GTolMul
    int sz = array.size(arr)
    if sz >= 4
        int upper = math.min(sz - 4, 30)
        for idx = 0 to upper
            Pivot pOut = array.get(arr, idx + 3)
            if (bar_index - pOut.bar > 1000)
                break
            projectMW(arr, idx + 3, idx + 2, idx + 1, idx, layerNum, depth, gtol)

// ============================================================================
//  تنظيف الاستباقيات + الترقية إلى مكتمل عند دخول PRZ (تغيّر اللون)
// ============================================================================
cleanGhosts() =>
    int i = array.size(gPat) - 1
    while i >= 0
        if i < array.size(gPat)
            Pattern p = array.get(gPat, i)
            bool rm = false
            bool promoted = false
            if p.isGhost
                if not p.activated
                    bool crossed = BREAK_ON_CLOSE ? (p.isBull ? (close <= p.pB) : (close >= p.pB)) : (p.isBull ? (low <= p.pB) : (high >= p.pB))
                    if crossed
                        p.activated := true

                float _przLo = math.min(p.przLow, p.przHigh)
                float _przHi = math.max(p.przLow, p.przHigh)
                bool inPRZnow = not na(p.przLow) and not na(p.przHigh) and (PRZ_ON_CLOSE ? (close >= _przLo and close <= _przHi) : (low <= _przHi and high >= _przLo))

                // ==== الترقية: أول بار يدخل فيه السعر PRZ فعلياً ====
                // نقفل D، نحوّل الحالة إلى ST_COMPLETED، وننقل النمط إلى قائمة
                // المكتملة. هذا هو ما يجعل اللون يتحوّل من الرمادي إلى الأحمر/
                // الأخضر. بعد الترقية لا تنطبق أي شروط حذف.
                if not p.dLocked and inPRZnow
                    p.pD := p.isBull ? math.max(math.min(low, _przHi), _przLo) : math.min(math.max(high, _przLo), _przHi)
                    p.bD := bar_index
                    p.tD := time
                    p.dLocked := true
                    // بناء نسخة مستقلة مكتملة وترقيتها. الكائنات في Pine تُسنَد
                    // بالمرجع، لذا نستخدم copy() لتفادي تعديل عنصر المصفوفة أثناء
                    // المرور عليها.
                    Pattern cp = p.copy()
                    cp.isGhost := false
                    cp.state   := ST_COMPLETED
                    cp.rXAD    := fibRatio(p.pA, p.pD, p.pX, p.pA)
                    cp.key     := patKey(p.name + "_C", p.isBull, p.layer, p.bX, p.bC, p.bD, p.bD)
                    cp.aNew    := false
                    cp.aActB   := false
                    cp.aPRZ    := false
                    cp.aComp   := false
                    registerPattern(cp)  // يحذف الاستباقي من gPat وينقله إلى cPat
                    promoted := true

                if not promoted and not inPRZnow and bar_index > p.bD + int(math.max((p.bD - p.bX) * 3, 80))
                    rm := true

                if not promoted and not rm and i_CBreakKill and not na(p.pC) and not na(p.pB)
                    if not p.extInit
                        p.extC := p.pC
                        p.extInit := true
                    float curExt = p.isBull ? high : low
                    p.extC := p.isBull ? math.max(p.extC, curExt) : math.min(p.extC, curExt)
                    float cPad = currentATR * CBREAK_ATR_MULT
                    rm := p.isBull ? (p.extC > p.pC + cPad) : (p.extC < p.pC - cPad)

                if not promoted and not rm
                    bool isExt = mwIsExt(p.name)
                    if isExt
                        rm := not i_CBreakKill and (p.isBull ? high > p.pA : low < p.pA)
                    else
                        rm := p.isBull ? low < p.pX : high > p.pX

                if not promoted and not rm and not na(p.przLow) and not na(p.przHigh)
                    float brk = math.abs(p.pA - p.pX) * 0.40
                    rm := p.isBull ? (low < _przLo - brk) : (high > _przHi + brk)
            if rm
                array.remove(gPat, i)
        i -= 1

// ============================================================================
//  التنفيذ الرئيسي
// ============================================================================
bool s1 = pivotScan(pv1, i_D1, currentATR, eff_atrFilter * 1.0, eff_RevSens)
bool s2 = pivotScan(pv2, i_D2, currentATR, eff_atrFilter * 1.5, eff_RevSens)
bool s3 = pivotScan(pv3, i_D3, currentATR, eff_atrFilter * 2.0, eff_RevSens)
bool s4 = pivotScan(pv4, i_D4, currentATR, eff_atrFilter * 3.0, eff_RevSens)
bool s5 = pivotScan(pv5, i_D5, currentATR, eff_atrFilter * 5.0, eff_RevSens)

bool u1 = i_L1 and s1
bool u2 = i_L2 and s2
bool u3 = i_L3 and s3
bool u4 = i_L4 and s4
bool u5 = i_L5 and s5

if barstate.isconfirmed
    if map.size(g_tried) > 500
        map.clear(g_tried)

    if u1
        scanComplete(pv1, 1)
        scanPredictive(pv1, 1)
    if u2
        scanComplete(pv2, 2)
        scanPredictive(pv2, 2)
    if u3
        scanComplete(pv3, 3)
        scanPredictive(pv3, 3)
    if u4
        scanComplete(pv4, 4)
        scanPredictive(pv4, 4)
    if u5
        scanComplete(pv5, 5)
        scanPredictive(pv5, 5)
    cleanGhosts()

// ============================================================================
//  دوال المقارنة للترتيب
// ============================================================================
patSpan(Pattern p) =>
    int endB = p.isGhost ? p.bC : p.bD
    math.max(endB - p.bX, 1)

patPrio(Pattern p) =>
    int   span     = (p.isGhost ? p.bC : p.bD) - p.bX
    float ref      = math.max(float(i_D5), 20.0)
    float sizeNorm = 1.0 - 1.0 / (1.0 + float(math.max(span, 0)) / ref)
    float w        = i_SizePref / 100.0
    float base     = (1.0 - w) * p.score + w * sizeNorm
    int   ageBar   = bar_index - (p.isGhost ? p.bC : p.bD)
    float recency  = 1.0 - math.min(float(math.max(ageBar, 0)) / (ref * 3.0), 1.0)
    float stability = array.includes(g_lastDrawnKeys, p.key) ? 0.06 : 0.0
    base + 0.15 * recency + stability

stronger(Pattern a, Pattern b) =>
    int   sa = patSpan(a)
    int   sb = patSpan(b)
    int   mx = math.max(sa, sb)
    int   mn = math.max(math.min(sa, sb), 1)
    float rel = float(mx - mn) / float(mx)
    bool res = false
    if rel < 0.15
        if a.score != b.score
            res := a.score > b.score
        else if sa != sb
            res := sa > sb
        else
            res := patPrio(a) >= patPrio(b)
    else
        res := sa > sb
    res

sameReversal(Pattern p, Pattern d) =>
    bool same = false
    if p.isBull == d.isBull
        int barTol = math.max(int(float(math.abs(p.bC - p.bX)) * 0.15), 5)
        float refPx = math.max(math.abs(p.pA), 1.0)
        float pxTol = refPx * 0.012
        bool skeleton = math.abs(p.bX - d.bX) <= barTol and math.abs(p.bC - d.bC) <= barTol and math.abs(p.pX - d.pX) < pxTol and math.abs(p.pA - d.pA) < pxTol and math.abs(p.pB - d.pB) < pxTol and math.abs(p.pC - d.pC) < pxTol
        if skeleton
            same := true
        else
            int pT0 = math.min(p.bX, p.bD)
            int pT1 = math.max(p.bX, p.bD)
            int dT0 = math.min(d.bX, d.bD)
            int dT1 = math.max(d.bX, d.bD)
            int tOv = math.min(pT1, dT1) - math.max(pT0, dT0)
            int tMin = math.max(math.min(pT1 - pT0, dT1 - dT0), 1)
            float tReq = XABCD_STRICT_OVERLAP ? 0.20 : 0.40
            bool tOverlap = tOv > 0 and float(tOv) / float(tMin) > tReq

            float pP0 = math.min(math.min(math.min(p.pX, p.pA), math.min(p.pB, p.pC)), p.pD)
            float pP1 = math.max(math.max(math.max(p.pX, p.pA), math.max(p.pB, p.pC)), p.pD)
            float dP0 = math.min(math.min(math.min(d.pX, d.pA), math.min(d.pB, d.pC)), d.pD)
            float dP1 = math.max(math.max(math.max(d.pX, d.pA), math.max(d.pB, d.pC)), d.pD)
            float sOv = math.min(pP1, dP1) - math.max(pP0, dP0)
            float sMin = math.max(math.min(pP1 - pP0, dP1 - dP0), 0.0000000001)
            bool sOverlap = sOv > 0 and sOv / sMin > tReq

            float dGap = math.abs(p.pD - d.pD)
            float dRef = math.max(math.max(math.abs(p.pA - p.pX), math.abs(d.pA - d.pX)), 1.0)
            bool  dClash = not na(p.pD) and not na(d.pD) and (dGap / dRef) < 0.20

            same := tOverlap or sOverlap or dClash
    same

// ============================================================================
//  الرسم
// ============================================================================
if barstate.islast
    for ln in gLines
        line.delete(ln)
    array.clear(gLines)
    for pl in gPolys
        polyline.delete(pl)
    array.clear(gPolys)
    for lb in gLabels
        label.delete(lb)
    array.clear(gLabels)
    for bx in gBoxes
        box.delete(bx)
    array.clear(gBoxes)

    int cCnt = array.size(cPat)
    int gCnt = array.size(gPat)

    int lineCap  = 100
    int labelCap = 150
    int compLineCap  = int(lineCap  * 0.60)
    int compLabelCap = int(labelCap * 0.60)

    array<Pattern> ranked = array.new<Pattern>()
    if cCnt > 0
        for i = 0 to cCnt - 1
            array.push(ranked, array.get(cPat, i))
    if gCnt > 0
        for i = 0 to gCnt - 1
            array.push(ranked, array.get(gPat, i))
    int rSz = array.size(ranked)
    if rSz > 1
        for a = 0 to rSz - 2
            for b = a + 1 to rSz - 1
                Pattern ra = array.get(ranked, a)
                Pattern rb = array.get(ranked, b)
                bool sw = false
                if (not rb.isGhost) and ra.isGhost
                    sw := true
                else if rb.isGhost == ra.isGhost and stronger(rb, ra)
                    sw := true
                if sw
                    array.set(ranked, a, rb)
                    array.set(ranked, b, ra)

    array<Pattern> toDraw = array.new<Pattern>()
    int countG = 0
    int countC = 0
    if rSz > 0
        for i = 0 to rSz - 1
            Pattern p = array.get(ranked, i)
            if p.isGhost
                if countG < i_MaxGhost
                    array.push(toDraw, p)
                    countG += 1
            else
                if countC < i_MaxComp
                    array.push(toDraw, p)
                    countC += 1
            if countG >= i_MaxGhost and countC >= i_MaxComp
                break

    int tdSz = array.size(toDraw)
    array<bool> dBeaten = array.new<bool>(tdSz, false)
    if tdSz > 1
        for a = 0 to tdSz - 1
            if not array.get(dBeaten, a)
                Pattern pa = array.get(toDraw, a)
                for b = 0 to tdSz - 1
                    if b != a and not array.get(dBeaten, b)
                        Pattern pb = array.get(toDraw, b)
                        if pa.isGhost == pb.isGhost and sameReversal(pa, pb)
                            if stronger(pa, pb)
                                array.set(dBeaten, b, true)
                            else
                                array.set(dBeaten, a, true)
                                break

    int drawSz = array.size(toDraw)
    int lastGhostD = 0
    for gi = 0 to (drawSz > 0 ? drawSz - 1 : 0)
        if gi < drawSz
            Pattern pg = array.get(toDraw, gi)
            if pg.isGhost and pg.bD > lastGhostD
                lastGhostD := pg.bD

    if drawSz > 0
        string globalLineSt = i_LineStyle == "dotted" ? line.style_dotted : i_LineStyle == "dashed" ? line.style_dashed : line.style_solid
        string lblSz = i_LblSize == "tiny" ? size.tiny : i_LblSize == "small" ? size.small : size.normal

        array<Pattern> drawn = array.new<Pattern>()
        int drawnG = 0
        int drawnC = 0

        for i = 0 to drawSz - 1
            if array.size(gPolys) >= 100
                break
            Pattern p = array.get(toDraw, i)
            if array.get(dBeaten, i)
                continue
            if p.isGhost
                if array.size(gLines) >= lineCap or array.size(gLabels) >= labelCap
                    break
            else
                if array.size(gLines) >= compLineCap or array.size(gLabels) >= compLabelCap
                    continue
            [_lo0, _lo1, pOn] = layerSpec(p.layer, eff_MinSizeMul)
            if not pOn or (not p.isGhost and p.bD < p.bX)
                continue
            // حارس المسافة: تخطّي الأنماط التي تقع نقطة منها أبعد من الحد المسموح
            // (يمنع إجهاض السكربت كله).
            int distPast   = bar_index - math.min(p.bX, p.bD)
            int distFuture = math.max(p.bX, p.bD) - bar_index
            if math.max(distPast, distFuture) > MAX_DRAW_DIST
                continue
            if p.isGhost and (bar_index - p.bC) > math.max((p.bD - p.bX) * 4, 120)
                continue
            if i_GhostAfterB and p.isGhost and not p.activated
                continue
            if p.isGhost and drawnG >= i_MaxGhost
                continue
            if not p.isGhost and drawnC >= i_MaxComp
                continue

            bool skip = false
            for di = 0 to array.size(drawn) - 1
                if di >= array.size(drawn)
                    break
                Pattern d = array.get(drawn, di)
                if p.isGhost == d.isGhost and sameReversal(p, d)
                    skip := true
                    break
            if skip
                continue
            array.push(drawn, p)
            if p.isGhost
                drawnG += 1
            else
                drawnC += 1

            bool isComp = not p.isGhost
            bool isG    = p.isGhost
            float dPrice = p.pD
            int msBar = g_msPerBar
            int dT = math.min(p.tD, time)
            if dT < p.tC
                dT := math.min(p.tC + msBar, time)

            // اللون: رمادي فقط للاستباقي الذي لم يصل PRZ بعد. بمجرد الترقية
            // (isGhost=false) يصبح أحمر/أخضر. وإضافةً لذلك، على البار الحي (قبل
            // أن يؤكِّد ويُرقّى في cleanGhosts) نكشف دخول PRZ لحظياً هنا حتى يتغيّر
            // اللون فوراً بدل انتظار إغلاق البار.
            bool _liveInPRZ = false
            if isG and not na(p.przLow) and not na(p.przHigh)
                float _dLo = math.min(p.przLow, p.przHigh)
                float _dHi = math.max(p.przLow, p.przHigh)
                _liveInPRZ := PRZ_ON_CLOSE ? (close >= _dLo and close <= _dHi) : (low <= _dHi and high >= _dLo)
            bool reachedPRZ = (not isG) or p.dLocked or _liveInPRZ
            if p.dLocked and isG
                dT := int(math.max(p.tD, p.tC + msBar))
            else
                int symSpan = int(math.max(p.tB - p.tX, msBar))
                int dTcap = int(p.tC + math.round(symSpan * DPROJ_SYM_MULT))
                dT := int(math.max(p.tC + msBar, math.min(dT, dTcap)))

            color baseCol = (isG and not reachedPRZ) ? i_GhostCol : (p.isBull ? i_BullCol : i_BearCol)

            int pulseA = isComp ? 15 : 60
            int diagA  = isComp ? 20 : 60
            color legC  = shade(baseCol, pulseA)
            color diagC = shade(baseCol, diagA)
            color ptTxt = shade(baseCol, 0)

            array<chart.point> legPts = array.new<chart.point>()
            array.push(legPts, chart.point.from_time(p.tX, p.pX))
            array.push(legPts, chart.point.from_time(p.tA, p.pA))
            array.push(legPts, chart.point.from_time(p.tB, p.pB))
            array.push(legPts, chart.point.from_time(p.tC, p.pC))
            array.push(legPts, chart.point.from_time(dT, dPrice))
            array.push(gPolys, polyline.new(legPts, curved = false, closed = false, xloc = xloc.bar_time, line_color = legC, line_style = globalLineSt, line_width = i_LineWidth))
            array.push(gLines, line.new(p.tX, p.pX, p.tB, p.pB, xloc = xloc.bar_time, color = diagC, style = globalLineSt, width = i_LineWidth))
            array.push(gLines, line.new(p.tA, p.pA, p.tC, p.pC, xloc = xloc.bar_time, color = diagC, style = globalLineSt, width = i_LineWidth))
            array.push(gLines, line.new(p.tB, p.pB, dT, dPrice, xloc = xloc.bar_time, color = diagC, style = globalLineSt, width = i_LineWidth))

            color noBg = color.new(color.white, 100)
            array.push(gLabels, label.new(p.tX, p.pX, "X", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))
            array.push(gLabels, label.new(p.tA, p.pA, "A", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))
            array.push(gLabels, label.new(p.tB, p.pB, "B", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))
            array.push(gLabels, label.new(p.tC, p.pC, "C", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))

            color nameBg = (isG and not reachedPRZ) ? shade(i_GhostCol, 88) : shade(baseCol, 90)
            color nameC  = shade(baseCol, 0)

            string confMark = isG and p.confScore >= 0.66 ? " ★" : ""
            string dTag = isG ? (p.name + confMark) : ("D " + p.name + " " + str.tostring(p.rXAD, "#.###"))
            array.push(gLabels, label.new(dT, dPrice, dTag, xloc = xloc.bar_time, color = nameBg, textcolor = nameC, style = p.isBull ? label.style_label_up : label.style_label_down, size = size.tiny))

            if not isG
                int mAB_t = int((p.tA + p.tB) / 2)
                float mAB_y = (p.pA + p.pB) / 2.0
                array.push(gLabels, label.new(mAB_t, mAB_y, str.tostring(p.rXAB, "#.###"), xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = size.tiny))
                int mBC_t = int((p.tB + p.tC) / 2)
                float mBC_y = (p.pB + p.pC) / 2.0
                array.push(gLabels, label.new(mBC_t, mBC_y, str.tostring(p.rABC, "#.###"), xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = size.tiny))

            if isG
                bool showPrice   = i_PRZShow == "Price"
                bool isLastGhost = p.bD == lastGhostD
                int idEt = isLastGhost ? int(math.max(dT + i_PRZLen * msBar, time)) : int(dT + i_PRZLen * msBar)
                int idLt = idEt + 3 * msBar
                color idC = shade(baseCol, 30)
                color idT = shade(baseCol, 12)

                float lvA  = na
                float lvB  = na
                string txtA = ""
                string txtB = ""
                [dLo, dHi] = mwD(p.name)
                lvA  := fibLevel(p.pX, p.pA, dLo, p.isBull)
                txtA := str.tostring(dLo, "#.###")
                if dHi != dLo
                    lvB  := fibLevel(p.pX, p.pA, dHi, p.isBull)
                    txtB := str.tostring(dHi, "#.###")

                bool przHasBand = not na(lvA) and not na(lvB)
                color przFillCol = shade(baseCol, 90)
                color przBordCol = shade(baseCol, 55)
                if przHasBand
                    float przTop = math.max(lvA, lvB)
                    float przBot = math.min(lvA, lvB)
                    array.push(gBoxes, box.new(dT, przTop, idEt, przBot, xloc = xloc.bar_time, border_color = przBordCol, border_width = 1, border_style = line.style_dotted, bgcolor = przFillCol))

                if not na(lvA)
                    array.push(gLines, line.new(dT, lvA, idEt, lvA, xloc = xloc.bar_time, color = idC, style = line.style_dotted, width = 1))
                    string labA = showPrice ? "(" + str.tostring(lvA, "#,###.00") + ")" : txtA
                    array.push(gLabels, label.new(idLt, lvA, labA, xloc = xloc.bar_time, color = noBg, textcolor = idT, style = label.style_none, size = lblSz))
                if not na(lvB)
                    array.push(gLines, line.new(dT, lvB, idEt, lvB, xloc = xloc.bar_time, color = idC, style = line.style_dotted, width = 1))
                    string labB = showPrice ? "(" + str.tostring(lvB, "#,###.00") + ")" : txtB
                    array.push(gLabels, label.new(idLt, lvB, labB, xloc = xloc.bar_time, color = noBg, textcolor = idT, style = label.style_none, size = lblSz))

            if isComp and not na(p.pC) and not na(dPrice)
                int cdT = int(math.max(p.tD, p.tC + msBar))
                int tEt = cdT + 70 * msBar
                int tLt = cdT + 74 * msBar
                color cdCol = shade(baseCol, 55)
                color cdTxt = shade(baseCol, 30)
                float cdR = dPrice - p.pC
                float t1 = dPrice - cdR * 0.382
                float t2 = dPrice - cdR * 0.618
                array.push(gLines, line.new(cdT, t1, tEt, t1, xloc = xloc.bar_time, color = cdCol, style = line.style_dotted, width = 1))
                array.push(gLabels, label.new(tLt, t1, ".382", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))
                array.push(gLines, line.new(cdT, t2, tEt, t2, xloc = xloc.bar_time, color = cdCol, style = line.style_dotted, width = 1))
                array.push(gLabels, label.new(tLt, t2, ".618", xloc = xloc.bar_time, color = noBg, textcolor = ptTxt, style = label.style_none, size = lblSz))

        array.clear(g_lastDrawnKeys)
        if array.size(drawn) > 0
            for i = 0 to array.size(drawn) - 1
                Pattern dpp = array.get(drawn, i)
                array.push(g_lastDrawnKeys, dpp.key)

// ============================================================================
//  التنبيهات
// ============================================================================
bool evNewGhost = false
bool evActB     = false
bool evPRZ      = false
bool evComp     = false

if barstate.isconfirmed
    string _sym = syminfo.ticker
    string _tf  = timeframe.period

    int _cN = array.size(cPat) - 1
    if _cN >= 0
        for i = 0 to _cN
            if i < array.size(cPat)
                Pattern p = array.get(cPat, i)
                if not p.aComp and p.state == ST_COMPLETED and not p.isGhost
                    string _dir = p.isBull ? "BULL" : "BEAR"
                    string _msg = "Completion " + _dir + " " + p.name + " | " + _sym + " " + _tf + " | D:" + str.tostring(p.pD, format.mintick) + " | L" + str.tostring(p.layer) + " | Score:" + str.tostring(p.score, "#.##")
                    alert(_msg, alert.freq_once_per_bar_close)
                    evComp := true
                    p.aComp := true
                    array.set(cPat, i, p)

    int _gN = array.size(gPat) - 1
    if _gN >= 0
        for i = 0 to _gN
            if i < array.size(gPat)
                Pattern p = array.get(gPat, i)
                if p.isGhost
                    string _dir = p.isBull ? "BULL" : "BEAR"
                    if not p.aNew
                        string _msg = "New predictive " + _dir + " " + p.name + " | " + _sym + " " + _tf + " | L" + str.tostring(p.layer) + " | Target D approx " + str.tostring(p.pD, format.mintick)
                        alert(_msg, alert.freq_once_per_bar_close)
                        evNewGhost := true
                        p.aNew := true
                    if not p.aActB and p.activated
                        string _msg = "Predictive activation " + _dir + " " + p.name + " | " + _sym + " " + _tf + " | L" + str.tostring(p.layer) + " | B broken, watching PRZ"
                        alert(_msg, alert.freq_once_per_bar_close)
                        evActB := true
                        p.aActB := true
                    if not p.aPRZ and not na(p.przLow) and not na(p.przHigh)
                        float _pLo = math.min(p.przLow, p.przHigh)
                        float _pHi = math.max(p.przLow, p.przHigh)
                        bool _inPRZ = PRZ_ON_CLOSE ? (close >= _pLo and close <= _pHi) : (low <= _pHi and high >= _pLo)
                        if _inPRZ
                            string _msg = "PRZ reached " + _dir + " " + p.name + " | " + _sym + " " + _tf + " | L" + str.tostring(p.layer) + " | Range:" + str.tostring(_pLo, format.mintick) + "-" + str.tostring(_pHi, format.mintick)
                            alert(_msg, alert.freq_once_per_bar_close)
                            evPRZ := true
                            p.aPRZ := true
                    array.set(gPat, i, p)

alertcondition(evComp,     title = "1) Harmonic pattern completion", message = "Harmonic pattern completion {{ticker}} {{interval}}")
alertcondition(evNewGhost, title = "2) Predictive pattern appears",   message = "Predictive harmonic pattern appears {{ticker}} {{interval}}")
alertcondition(evActB,     title = "3) Predictive activation (B break)", message = "Predictive pattern activation {{ticker}} {{interval}}")
alertcondition(evPRZ,      title = "4) Price reaches PRZ",    message = "Price reaches PRZ zone {{ticker}} {{interval}}")
alertcondition(evComp or evNewGhost or evActB or evPRZ, title = "Any harmonic event (comprehensive)", message = "Harmonic event {{ticker}} {{interval}}")

plot(close, display = display.none)
